# PhotoMapper environment configuration (OPS-07)
# Copy to .env for local overrides. All values are optional; defaults shown.
# See docs/DEPLOYMENT-SECURITY.md for production guidance.

# development | production | test
NODE_ENV=development

# App listen port (keep behind the reverse proxy in production)
PORT=3001

# Where all state lives (the image sets /config). DB_PATH and UPLOADS_DIR default
# to photos.db and uploads/ inside it; without DATA_DIR they default to server/.
# DATA_DIR=./data
# DB_PATH=./server/photos.db        (replaces PHOTOS_DB_PATH, which still works)
# UPLOADS_DIR=./server/uploads

# Proxy hops in front whose forwarded headers are trusted. Off (0) by default; 1 when
# nginx restores the real client IP, so req.ip / rate-limiting reflect the real client.
# TRUST_PROXY=1

# Comma-separated allowed CORS origins. Leave empty for same-origin only.
# ALLOWED_ORIGINS=https://photomapper.example.com

# Enable the destructive DELETE /api/reset endpoint. Off unless set to true.
ALLOW_RESET=false

# Upload size cap in bytes (default 60 MB). Keep in step with the proxy limit.
UPLOAD_MAX_BYTES=62914560

# Per-IP rate limit over all of /api: "<n> per [<k>] <second|minute|hour|day>".
API_RATE=1000 per 15 minutes

# Log level: fatal | error | warn | info | debug | trace | silent (forced silent under test)
LOG_LEVEL=info
